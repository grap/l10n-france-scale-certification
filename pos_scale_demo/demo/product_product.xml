<odoo>

    <record model="product.product" id="product_peanut_butter">
        <field name="name">Peanut Butter</field>
        <field name="categ_id" ref="product.product_category_all" />
        <field name="list_price">16.55</field>
        <field name="pos_categ_id" ref="pos_category_food" />
        <field name="available_in_pos" eval="True" />
        <field name="to_weight" eval="True" />
        <field name="uom_id" ref="uom.product_uom_kgm" />
        <field name="uom_po_id" ref="uom.product_uom_kgm" />
        <field name="company_id" ref="base.main_company" />
        <field
            name="image_1920"
            type="base64"
            file="pos_scale_demo/static/img/demo/product_product/product_peanut_butter.jpg"
        />
    </record>

    <record model="product.product" id="product_strawberry">
        <field name="name">Strawberry (250 gr)</field>
        <field name="categ_id" ref="product.product_category_all" />
        <field name="list_price">3.10</field>
        <field name="pos_categ_id" ref="pos_category_food" />
        <field name="available_in_pos" eval="True" />
        <field name="uom_id" ref="uom.product_uom_unit" />
        <field name="uom_po_id" ref="uom.product_uom_unit" />
            <field
            name="image_1920"
            type="base64"
            file="pos_scale_demo/static/img/demo/product_product/product_strawberry.jpg"
        />
        <field name="company_id" ref="base.main_company" />
    </record>

    <record model="product.product" id="product_apple">
        <field name="name">Apple - Tare 0.005 kg (Kraft Bag)</field>
        <field name="categ_id" ref="product.product_category_all" />
        <field name="list_price">2.45</field>
        <field name="pos_categ_id" ref="pos_category_food" />
        <field name="available_in_pos" eval="True" />
        <field name="to_weight" eval="True" />
        <field name="tare_weight">0.005</field>
        <field name="uom_id" ref="uom.product_uom_kgm" />
        <field name="uom_po_id" ref="uom.product_uom_kgm" />
        <field
            name="image_1920"
            type="base64"
            file="pos_scale_demo/static/img/demo/product_product/product_apple.jpg"
        />
        <field name="company_id" ref="base.main_company" />
    </record>

</odoo>
